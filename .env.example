# =====================================================================
# Beverage Quality Analysis System (BQAS) - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ---------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional USDA FoodData Central API Key (kept strictly server-side)
# If omitted, Open Food Facts is used as the primary nutritional provider.
USDA_API_KEY=DEMO_KEY

# ---------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ---------------------------------------------------------------------
# Empty string defaults to relative requests proxied via Vite dev server
VITE_API_BASE_URL=
